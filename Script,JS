    { nome: "BAUNILHA",  preco: 5, img: "🍦" },
    { nome: "MISTO",     preco: 5, img: "🍦" }
  ],
  "CASCÃO": [
    { nome: "CHOCOLATE", preco: 10, img: "🍨" },
    { nome: "BAUNILHA",  preco: 10, img: "🍨" },
    { nome: "MISTO",     preco: 10, img: "🍨" }
  ],
  "AÇAÍ": [
    { nome: "PERSONALIZADO", preco: 17, img: "🥣" },
    { nome: "COMPLETO",      preco: 17, img: "🍧" },
    { nome: "MILK SHAKE",    preco: 17, img: "🥤" }
  ],
  "MILK SHAKE": [
