  ]
};

const categorias = ["CASQUINHA", "CASCÃO", "AÇAÍ", "MILK SHAKE", "TWIST"];

// ===== CARRINHO =====
let carrinho = [];

function adicionar(nome, preco) {
  carrinho.push({ nome: nome, preco: preco });
  atualizarCarrinho();
}

function atualizarCarrinho() {
  const qtd = carrinho.length;
  let total = 0;
  for (let i = 0; i < carrinho.length; i++) {
    total += carrinho[i].preco;
  }
  const totalFormatado = total.toFixed(2).replace(".", ",");

  document.getElementById("qtdCat").innerText = qtd;
  document.getElementById("qtdProd").innerText = qtd;
  document.getElementById("totalCat").innerText = totalFormatado;
  document.getElementById("totalProd").innerText = totalFormatado;
}

// ===== TROCAR DE TELA =====
function mostrarTela(idTela) {
  // esconde todas as telas
  const telas = document.getElementsByClassName("tela");
  for (let i = 0; i < telas.length; i++) {
    telas[i].classList.add("escondida");
  }
  // mostra a tela escolhida
  document.getElementById(idTela).classList.remove("escondida");

  // se for a tela de categorias, monta a lista
  if (idTela === "telaCategorias") {
    montarCategorias();
  }
}

// ===== MONTAR CATEGORIAS =====
function montarCategorias() {
  const lista = document.getElementById("listaCategorias");
  lista.innerHTML = "";

  for (let i = 0; i < categorias.length; i++) {
    const cat = categorias[i];
    const botao = document.createElement("button");
    botao.className = "botao-categoria";
    botao.innerText = cat;
    botao.onclick = function () {
      abrirProdutos(cat);
    };
    lista.appendChild(botao);
  }
}

// ===== MONTAR PRODUTOS =====
function abrirProdutos(categoria) {
  document.getElementById("tituloCategoria").innerText = categoria;

  const lista = document.getElementById("listaProdutos");
  lista.innerHTML = "";

  const itens = produtos[categoria];
  const ehAcai = categoria === "AÇAÍ";

  for (let i = 0; i < itens.length; i++) {
    const item = itens[i];
    const precoFormatado = item.preco.toFixed(2).replace(".", ",");

    const card = document.createElement("div");
    card.className = "card-produto";
    card.innerHTML = `
      <div class="imagem">${item.img}</div>
      <div class="info">
        <div class="nome">${item.nome}</div>
        ${ehAcai ? '<div class="apartir">A PARTIR DE</div>' : ''}
        <div class="preco">R$ ${precoFormatado}</div>
      </div>
      <button class="botao-mais">+</button>
    `;
    card.querySelector(".botao-mais").onclick = function () {
      adicionar(item.nome, item.preco);
    };
    lista.appendChild(card);
  }

  mostrarTela("telaProdutos");
}
